# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ENVIRONMENT & DEMO MODE CONFIGURATION
# Safe default. Live Supabase access requires explicitly setting VITE_DEMO_MODE=false.
VITE_APP_ENV="development"
VITE_DEMO_MODE="true"

# SUPABASE CONFIGURATION (PostgreSQL + Auth + RLS)
# Browser-safe Supabase publishable key only. Never put service_role/secret keys here.
# Keep blank while VITE_DEMO_MODE=true.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
# Legacy anon key fallback supported by src/lib/supabase.ts:
VITE_SUPABASE_ANON_KEY=""

# SENTRY ERROR MONITORING
# Sensitive PII (salaries, bank details, Aadhaar, PAN, biometrics) is automatically scrubbed.
VITE_SENTRY_DSN=""

# HIKVISION CONNECTOR SERVICE (Edge Daemon on Branch LAN)
# The local daemon proxies requests from LAN to Supabase.
VITE_DEVICE_CONNECTOR_URL=""
