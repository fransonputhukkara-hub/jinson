# Server-only Supabase secret. Never put this value in VITE_* or Git.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=REPLACE_WITH_SERVER_ONLY_SB_SECRET_KEY

# Must exactly match attendance_devices.serial_number in Supabase.
HIKVISION_DEVICE_SERIAL=DS-K1T320MFWX20241227V030520ENGR3024763

# Generate with: openssl rand -hex 32
# Use the same random value in the device HTTP Listening URL path.
HIKVISION_WEBHOOK_TOKEN=REPLACE_WITH_AT_LEAST_32_URL_SAFE_RANDOM_CHARACTERS

# Bind only to loopback; Caddy terminates public HTTPS on port 443.
HOST=127.0.0.1
PORT=3100
MAX_BODY_BYTES=8388608
